            "protoDescriptors": "",
            "protoFile": "syntax = \"proto3\";\n\npackage platform.notifications.v1;\n\nimport \"google/protobuf/timestamp.proto\";\n\n// Только доверенные сервисы. Инициатор определяется по идентичности соединения.\nservice NotificationsService {\n  // Повтор исходного поручения возвращает текущее состояние начатых попыток.\n  rpc SendNotification(SendNotificationRequest) returns (SendNotificationResponse);\n}\n\nmessage SendNotificationRequest {\n  // UUID, стабильный для всех повторов одного поручения.\n  string dispatch_id = 1;\n  string text = 2;\n  // В TypeScript-клиенте ключ обязателен. undefined опускается при сериализации.\n  optional string email = 3;\n  // Для отправки только по email инициатор явно указывает phone: undefined.\n  optional string phone = 4;\n  // Для каждого запрошенного канала возвращается отдельный результат.\n  repeated NotificationChannel channels = 5;\n  // Верхняя граница начала передачи. Обязательна для кодов и приглашений.\n  google.protobuf.Timestamp expires_at = 6;\n  // Явный повтор временных, заведомо не принятых попыток. UUID получены из ответа.\n  repeated string retry_attempt_ids = 7;\n}\n\nenum NotificationChannel {\n  NOTIFICATION_CHANNEL_UNSPECIFIED = 0;\n  NOTIFICATION_CHANNEL_EMAIL = 1;\n  NOTIFICATION_CHANNEL_TELEGRAM = 2;\n  // До подключения адаптера результат — NOT_SENT с причиной unsupported_channel.\n  NOTIFICATION_CHANNEL_MAX = 3;\n}\n\nenum SubmissionStatus {\n  SUBMISSION_STATUS_UNSPECIFIED = 0;\n  SUBMISSION_STATUS_SENT = 1;\n  SUBMISSION_STATUS_NOT_SENT = 2;\n  SUBMISSION_STATUS_UNCONFIRMED = 3;\n}\n\nmessage ChannelResult {\n  NotificationChannel channel = 1;\n  SubmissionStatus status = 2;\n  // Стабильная безопасная причина из словаря дизайна.\n  optional string reason = 3;\n  // Отсутствует для пропусков до создания попытки.\n  optional string attempt_id = 4;\n  bool retryable = 5;\n}\n\nmessage SendNotificationResponse {\n  string dispatch_id = 1;\n  repeated ChannelResult results = 2;\n}\n"
          }
        },
