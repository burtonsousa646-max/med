# Переменные локального окружения. Скопировать в deploy/.env — он не попадает в git.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
# 5433, а не 5432, чтобы не конфликтовать с локальным PostgreSQL прототипа
POSTGRES_PORT=5433
REDIS_PORT=6379
UNLEASH_PORT=4242

# Unleash — только локальные значения, на стендах токены свои.
# Токен для сервисов и gateway: проект default, окружение development.
UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_TOKEN=default:development.local-backend-token
# Токен администратора — для pnpm env:flags и включения флагов в автотестах.
UNLEASH_ADMIN_URL=http://localhost:4242/api/admin
UNLEASH_ADMIN_TOKEN=*:*.local-admin-token

# Suggestion — зависимости для локальной разработки; процессы приложений добавляет BE.
GATEWAY_HTTP_PORT=3000
SUGGESTION_SCOPE=local
SUGGESTION_PROVIDER=stub
# Для процессов на хосте; в профиле gateway используется suggestion-service:50051.
SUGGESTION_GRPC_TARGET=127.0.0.1:50051
SUGGESTION_RATE_REDIS_PORT=6380
SUGGESTION_CACHE_REDIS_PORT=6381
# Для процессов на хосте; gateway в Compose подключается к suggestion-rate-redis:6379.
SUGGESTION_RATE_REDIS_URL=redis://127.0.0.1:6380
SUGGESTION_CACHE_REDIS_URL=redis://127.0.0.1:6381
SUGGESTION_RATE_LIMIT_RPS=5
SUGGESTION_REDIS_TIMEOUT_MS=100
SUGGESTION_TIMEOUT_MS=1500
SUGGESTION_CACHE_TTL_SEC=86400
GATEWAY_TRUSTED_PROXY_CIDRS=
# Только синтетические локальные значения; в общих окружениях — разные случайные секреты.
SUGGESTION_RATE_HMAC_SECRET=local-rate-placeholder-change-before-shared-env
SUGGESTION_CACHE_HMAC_SECRET=local-cache-placeholder-change-before-shared-env
# Только для cloud: задать адрес и реальный ключ вне репозитория.
# DADATA_CLOUD_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/
# DADATA_CLOUD_API_KEY=
