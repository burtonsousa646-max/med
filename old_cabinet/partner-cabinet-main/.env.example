# Скопируйте этот файл в .env.local (он в .gitignore, не попадёт в git) и впишите свой ключ.
# Тот же OPENAI_API_KEY нужно добавить в Project Settings → Environment Variables на Vercel
# при деплое — ключ никогда не должен попадать в код или в клиентский бандл.

OPENAI_API_KEY=

# Необязательно — модели по умолчанию:
# OPENAI_CHAT_MODEL=gpt-4.1
# OPENAI_ASSISTANT_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
