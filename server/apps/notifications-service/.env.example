GRPC_HOST=127.0.0.1
GRPC_PORT=50057
NOTIFICATIONS_DATABASE_URL=postgresql://localhost/notifications
NOTIFICATIONS_CHANNEL_TIMEOUT_MS=3000
NOTIFICATIONS_RESULT_RESERVE_MS=150
NOTIFICATIONS_TLS_CA_FILE=
NOTIFICATIONS_TLS_CERT_FILE=
NOTIFICATIONS_TLS_KEY_FILE=
# JSON-объект: SHA-256 сертификата в hex без двоеточий → имя сервиса.
NOTIFICATIONS_CLIENT_CERTIFICATES={}
# JSON-объект: версия → секрет HMAC в hex (минимум 32 байта).
NOTIFICATIONS_HMAC_CURRENT=v1
NOTIFICATIONS_HMAC_KEYS={}

# Для локального Haraka см. specs/guides/notifications-smtp.md.
NOTIFICATIONS_SMTP_HOST=
# NOTIFICATIONS_SMTP_PORT=587
# NOTIFICATIONS_SMTP_TLS_MODE=starttls
NOTIFICATIONS_SMTP_CA_FILE=
NOTIFICATIONS_SMTP_SENDER_CONFIG=
NOTIFICATIONS_SMTP_FROM=
NOTIFICATIONS_SMTP_SUBJECT=
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=

UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_TOKEN=

# Для подключения Postbox заполните настройки, включая HTTPS-адрес без пути.
# NOTIFICATIONS_POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
NOTIFICATIONS_POSTBOX_SENDER_CONFIG=
NOTIFICATIONS_POSTBOX_FROM=
NOTIFICATIONS_POSTBOX_SUBJECT=
NOTIFICATIONS_POSTBOX_CONFIGURATION_SET=
NOTIFICATIONS_POSTBOX_IAM_TOKEN=
