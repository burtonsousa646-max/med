            "protoFile": "syntax = \"proto3\";\n\npackage platform.partners.v1;\n\nimport \"google/protobuf/timestamp.proto\";\n\n// UUID передаются строками. Неверные параметры — INVALID_ARGUMENT, чужой ресурс — NOT_FOUND,\n// отсутствие полномочия — PERMISSION_DENIED, конфликт членства, состояния или ключа —\n// ABORTED (409). Для занятого ИНН — ALREADY_EXISTS с кодом invitation_required.\n// Временная недоступность — UNAVAILABLE. Профиль и контакты выдаются доверенным потребителям.\nservice PartnersService {\n  // Auth передаёт стабильный UUID регистрации. Повтор возвращает прежний user_id.\n  rpc EnsureUserProfile(EnsureUserProfileRequest) returns (EnsureUserProfileResponse);\n  // Возвращает профиль для подтверждённого пользователя. До членства организация отсутствует.\n  rpc GetUserProfile(GetUserProfileRequest) returns (GetUserProfileResponse);\n  // Для оформления кампании. Сначала используется текущее членство, иначе регистрируется свободный ИНН.\n  rpc ResolveCampaignOrganization(ResolveCampaignOrganizationRequest) returns (ResolveCampaignOrganizationResponse);\n  // Проверяет действующую пару. Для неподтверждённой пары NOT_FOUND без данных организации.\n  rpc GetRepresentative(GetRepresentativeRequest) returns (GetRepresentativeResponse);\n  // Новый ключ заменяет приглашение для той же организации и адреса. Повтор ключа возвращает тот же результат.\n  rpc CreateInvitation(CreateInvitationRequest) returns (CreateInvitationResponse);\n  // Подтверждённый адрес берётся из сессии Auth. Повтор тем же получателем идемпотентен.\n  rpc AcceptInvitation(AcceptInvitationRequest) returns (AcceptInvitationResponse);\n  // Создатель отзывает ожидающее приглашение. Повтор отзыва им же идемпотентен.\n  rpc RevokeInvitation(RevokeInvitationRequest) returns (RevokeInvitationResponse);\n}\n\nmessage Organization {\n  string organization_id = 1;\n  string inn = 2;\n  optional string customer_name = 3;\n}\n\nmessage UserProfile {\n  string user_id = 1;\n  optional string contact_email = 2;\n  optional string phone = 3;\n  Organization organization = 4;\n  bool can_invite = 5;\n}\n\nmessage Invitation {\n  string invitation_id = 1;\n  google.protobuf.Timestamp expires_at = 2;\n}\n\nmessage EnsureUserProfileRequest {\n  string registration_id = 1;\n  string verified_email = 2;\n}\n\nmessage EnsureUserProfileResponse {\n  string user_id = 1;\n}\n\nmessage GetUserProfileRequest {\n  string user_id = 1;\n}\n\nmessage GetUserProfileResponse {\n  UserProfile profile = 1;\n}\n\nmessage ResolveCampaignOrganizationRequest {\n  string user_id = 1;\n  string inn = 2;\n  optional string customer_name = 3;\n}\n\nmessage ResolveCampaignOrganizationResponse {\n  Organization organization = 1;\n}\n\nmessage GetRepresentativeRequest {\n  string user_id = 1;\n  string organization_id = 2;\n}\n\nmessage GetRepresentativeResponse {\n  UserProfile profile = 1;\n}\n\nmessage CreateInvitationRequest {\n  string actor_user_id = 1;\n  string recipient_email = 2;\n  string idempotency_key = 3;\n}\n\nmessage CreateInvitationResponse {\n  Invitation invitation = 1;\n}\n\nmessage AcceptInvitationRequest {\n  string actor_user_id = 1;\n  string verified_email = 2;\n  string invitation_id = 3;\n}\n\nmessage AcceptInvitationResponse {}\n\nmessage RevokeInvitationRequest {\n  string actor_user_id = 1;\n  string invitation_id = 2;\n}\n\nmessage RevokeInvitationResponse {}\n"
          }
        },
