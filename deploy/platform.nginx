# Рекламная платформа: интерфейс из dist, API на 127.0.0.1:8788. https допишет certbot.
server {
    listen 80;
    server_name platform.napovtor.ru;

    root /opt/ads-platform/dist;
    client_max_body_size 4m;

    # стенд не индексируется
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location /api/ {
        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # ключ сервера партнёра в адресе постбэка — в журнал nginx не пишем
        location /api/public/postback {
            access_log off;
            proxy_pass http://127.0.0.1:8788;
            # заголовки прокси в nginx не наследуются, если в блоке есть свои — повторяем
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # сборка с хешами в именах — навсегда; страница — всегда свежая
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable" always; add_header X-Robots-Tag "noindex, nofollow, noarchive" always; }
    location = /index.html { add_header Cache-Control "no-cache" always; add_header X-Robots-Tag "noindex, nofollow, noarchive" always; }
    location / { try_files $uri /index.html; }
}
