{
  "name": "@platform/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "env:up": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d --wait && pnpm env:flags",
    "env:flags": "node --env-file=deploy/.env deploy/unleash/seed.mjs",
    "env:down": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env down",
    "ai:adapters": "node ai/adapters/generate.mjs",
    "ai:adapters:check": "node ai/adapters/generate.mjs --check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
