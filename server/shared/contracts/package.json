{
  "name": "@platform/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Код gRPC из api/proto/ для сервисов и API Gateway: сообщения, клиенты и интерфейсы контроллеров NestJS",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-proto.mjs"
  },
  "peerDependencies": {
    "@nestjs/microservices": "^12.4.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/microservices": "^12.4.0",
    "@platform/server-tooling": "workspace:*",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
