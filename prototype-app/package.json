    "@hono/node-server": "^2.1.5",
    "@tanstack/react-query": "^5.104.5",
    "hono": "^4.13.13",
    "lucide-react": "1.61.0",
    "motion": "14.5.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "^19.3.1",
    "react-router": "8.5.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.18"
  }
