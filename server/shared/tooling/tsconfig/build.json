{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./service.json",
  "compilerOptions": {
    "noEmit": false,
    "sourceMap": true,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist"
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/src/**/*.spec.ts"]
}
