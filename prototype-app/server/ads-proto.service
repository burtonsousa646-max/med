# systemd-служба тестового API на ads.napovtor.ru. Ставит deploy.sh; nginx отдаёт ей /api/
# Node 22 лежит отдельно в /opt/node22: системный Node 20 нужен приложениям под pm2
[Unit]
Description=Рекламная платформа билайна: тестовый API прототипа
After=network.target

[Service]
WorkingDirectory=/opt/ads-proto
ExecStart=/opt/node22/bin/node --disable-warning=ExperimentalWarning server/index.ts
Environment=API_PORT=8787 DB_PATH=/var/lib/ads-proto/demo.sqlite
# ключ Claude для ИИ-поиска витрины: ANTHROPIC_API_KEY=... (файл необязателен — без него поиск по словам)
EnvironmentFile=-/etc/ads-proto.env
LoadCredential=ads-proto-resend-api-key
StateDirectory=ads-proto
User=www-data
Restart=on-failure

[Install]
WantedBy=multi-user.target
