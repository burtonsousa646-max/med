generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

model EmailChallenge {
  id         String          @id @db.Uuid
  email      String          @unique
  sealedCode String          @map("sealed_code")
  expiresAt  DateTime        @map("expires_at") @db.Timestamptz(3)
  lastSentAt DateTime        @map("last_sent_at") @db.Timestamptz(3)
  attempts   Int             @default(0)
  consumed   Boolean         @default(false)
  deliveries EmailDelivery[]

  @@map("email_challenges")
}

model EmailDelivery {
  id          String         @id @db.Uuid
  challengeId String         @map("challenge_id") @db.Uuid
  challenge   EmailChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  sentAt      DateTime?      @map("sent_at") @db.Timestamptz(3)

  @@index([challengeId])
  @@map("email_deliveries")
}

model AuthIdentity {
  provider       String
  subject        String
  registrationId String   @unique @map("registration_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  retryAt        DateTime @default(now()) @map("retry_at") @db.Timestamptz(3)

  @@id([provider, subject])
  @@index([userId, retryAt])
  @@map("auth_identities")
}

model AuthSession {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  verifiedEmail  String   @map("verified_email")
  refreshHash    String   @unique @map("refresh_hash") @db.Char(64)
  lastActivityAt DateTime @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  accessTokens   AccessToken[]
  @@map("auth_sessions")
}

model AccessToken {
  hash      String   @id @db.Char(64)
  sessionId String   @map("session_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId])
  @@map("access_tokens")
}
