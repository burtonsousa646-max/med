# Переменные локального окружения. Скопировать в deploy/.env — он не попадает в git.
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
# 5433, а не 5432, чтобы не конфликтовать с локальным PostgreSQL прототипа
POSTGRES_PORT=5433
REDIS_PORT=6379
UNLEASH_PORT=4242

# Unleash — только локальные значения, на стендах токены свои.
# Токен для сервисов и gateway: проект default, окружение development.
UNLEASH_URL=http://localhost:4242/api
UNLEASH_API_TOKEN=default:development.local-backend-token
# Токен администратора — для pnpm env:flags и включения флагов в автотестах.
UNLEASH_ADMIN_URL=http://localhost:4242/api/admin
UNLEASH_ADMIN_TOKEN=*:*.local-admin-token
