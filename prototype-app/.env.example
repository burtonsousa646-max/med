# Docker Compose reads this file after copying it to .env.
HTTP_PORT=8080
IMAGE_TAG=local

# Public frontend counter ID. Empty disables Yandex Metrica. Rebuild web after changing.
VITE_METRIKA_ID=
# Local diagnostic logging only; localhost never sends data to Yandex.
VITE_METRIKA_DEBUG=false

# Standalone HTTPS: hostname only, without scheme or path. Set DNS A/AAAA first.
DOMAIN=ads.example.com
# Set true when the browser accesses the site through HTTPS (including host nginx).
COOKIE_SECURE=false

# Optional server-only integrations. Leave empty for the existing fallback/demo.
ANTHROPIC_API_KEY=
DADATA_API_KEY=
# Empty means the server's existing default; use an available model from your account.
NEAR_AI_MODEL=
