[Unit]
Description=Рекламная платформа: воркер (очередь, расчёты, свёртки)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=ads-platform
Group=ads-platform
WorkingDirectory=/opt/ads-platform
EnvironmentFile=/etc/ads-platform.env
ExecStart=/opt/node22/bin/node server/worker.ts
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ads-platform
PrivateTmp=true

[Install]
WantedBy=multi-user.target
